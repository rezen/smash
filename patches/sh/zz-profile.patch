+// IgnoreErrexit makes the runner preserve non-zero command statuses while
+// preventing the errexit shell option from terminating execution. Conditional
+// and AND/OR-list semantics are unchanged. It is intended for profiling.
+func IgnoreErrexit(enabled bool) RunnerOption {
+	return func(r *Runner) error { r.ignoreErrexit = enabled; return nil }
+}
