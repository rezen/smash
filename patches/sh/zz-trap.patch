+
+// smash patch: trapSignal canonicalises a `trap` signal spec to the bare
+// upper-case name bash lists it under, reporting whether bash would accept it
+// at all. bash takes a signal name with or without the SIG prefix in any case
+// ("int", "SIGINT"), a signal number ("2"), and the pseudo-signals EXIT (0)
+// and ERR. Upstream understood only ERR and EXIT and failed the builtin with
+// status 2 for anything else, which under `set -e` aborts every installer that
+// registers the usual `trap cleanup INT TERM`.
+func trapSignal(spec string) (string, bool) {
+	name := strings.ToUpper(spec)
+	if n, err := strconv.ParseUint(name, 10, 16); err == nil {
+		name, ok := trapSignalNumbers[n]
+		return name, ok
+	}
+	switch name {
+	case "EXIT", "ERR":
+		return name, true
+	}
+	if name = strings.TrimPrefix(name, "SIG"); slices.Contains(trapSignalNames, name) {
+		return name, true
+	}
+	return "", false
+}
+
+// trapSignalNumbers holds the signal numbers POSIX fixes to the same value on
+// every platform, so that a numeric spec means the same thing here as it does
+// to the host's shell. The signals whose numbers differ between Linux and
+// Darwin (USR1, USR2, BUS, SYS, …) are accepted by name only, which is how
+// scripts write them.
+var trapSignalNumbers = map[uint64]string{
+	0:  "EXIT",
+	1:  "HUP",
+	2:  "INT",
+	3:  "QUIT",
+	4:  "ILL",
+	5:  "TRAP",
+	6:  "ABRT",
+	8:  "FPE",
+	9:  "KILL",
+	11: "SEGV",
+	13: "PIPE",
+	14: "ALRM",
+	15: "TERM",
+}
+
+// trapSignalNames holds every signal name bash accepts on Linux or Darwin,
+// without the SIG prefix.
+var trapSignalNames = []string{
+	"ABRT", "ALRM", "BUS", "CHLD", "CLD", "CONT", "EMT", "FPE", "HUP", "ILL",
+	"INFO", "INT", "IO", "IOT", "KILL", "PIPE", "POLL", "PROF", "PWR", "QUIT",
+	"SEGV", "STKFLT", "STOP", "SYS", "TERM", "TRAP", "TSTP", "TTIN", "TTOU",
+	"URG", "USR1", "USR2", "VTALRM", "WINCH", "XCPU", "XFSZ",
+}
