+// smash patch: the shell's descriptor table beyond 0/1/2.
+
+func (r *Runner) getOut(fd string) (io.Writer, bool) {
+	switch fd {
+	case "1":
+		return r.stdout, true
+	case "2":
+		return r.stderr, true
+	}
+	w, ok := r.extraOut[fd]
+	return w, ok
+}
+
+func (r *Runner) setOut(fd string, w io.Writer) {
+	switch fd {
+	case "0", "1": // `0>file` is nonsense; keep the old behaviour of using stdout
+		r.stdout = w
+	case "2":
+		r.stderr = w
+	default:
+		if r.extraOut == nil {
+			r.extraOut = map[string]io.Writer{}
+		}
+		r.extraOut[fd] = w
+	}
+}
+
+func (r *Runner) getIn(fd string) (stdinFile, bool) {
+	if fd == "0" {
+		return r.stdin, true
+	}
+	in, ok := r.extraIn[fd]
+	return in, ok
+}
+
+func (r *Runner) setIn(fd string, in stdinFile) {
+	if fd == "0" {
+		r.stdin = in
+		return
+	}
+	if r.extraIn == nil {
+		r.extraIn = map[string]stdinFile{}
+	}
+	r.extraIn[fd] = in
+}
