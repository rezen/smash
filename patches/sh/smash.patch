+// isBodyCompound reports whether cm is a compound command whose exit status is
+// simply that of the last statement run in its body (if/then, { }, for, while,
+// case) — as opposed to a subshell or a function call, which bash treats as a
+// command in its own right for errexit.
+func isBodyCompound(cm syntax.Command) bool {
+	switch cm.(type) {
+	case *syntax.IfClause, *syntax.Block, *syntax.ForClause, *syntax.WhileClause, *syntax.CaseClause:
+		return true
+	}
+	return false
